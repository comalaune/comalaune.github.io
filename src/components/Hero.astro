---
import { Image } from 'astro:assets';
import portrait from '../assets/apolline-portfolio-cutout.png';
import logo from '../assets/logo.png';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-visual">
    <div class="hero-logo">
      <Image
        src={logo}
        width={600}
        alt="Com’ à la une"
        format="webp"
        loading="eager"
      />
    </div>
    <div class="portrait-frame">
      <Image
        src={portrait}
        alt="Apolline Deau, fondatrice de Com’ à la une"
        width={420}
        densities={[1, 2]}
        quality={90}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="hero-copy">
    <h1 id="hero-title">
      Une communication qui avance <em>ensemble.</em>
    </h1>
    <p class="hero-description">
      Je donne vie à vos idées et du sens à votre communication.
    </p>
    <div class="hero-actions">
      <a href="#contact" class="button">
        Parlons de votre projet
      </a>
      <a href="#realisations" class="text-link">
        Voir mes réalisations
      </a>
    </div>
    <p class="hero-signature">
      Apolline Deau <span aria-hidden="true">·</span> Communication & création
      de contenu
    </p>
  </div>
</section>
